{
  "name": "swissqrbill-microservice",
  "version": "0.2.0",
  "private": false,
  "description": "Self-hostable Swiss QR Bill microservice with HTTP API and HTML form, powered by schoero/swissqrbill.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=25 <26"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepare": "git config core.hooksPath .githooks || true",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "swiss-qr-bill",
    "qr-bill",
    "microservice",
    "fastify",
    "typescript",
    "pdf",
    "svg"
  ],
  "dependencies": {
    "@fastify/formbody": "9.0.0",
    "@fastify/rate-limit": "11.2.0",
    "@fastify/static": "10.1.3",
    "fastify": "^5.12.1",
    "pdfkit": "0.20.1",
    "swissqrbill": "4.4.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.0.0",
    "@types/pdfkit": "0.17.6",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "10.5.0",
    "globals": "17.11.0",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0",
    "vitest": "4.1.11"
  }
}
